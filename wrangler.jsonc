{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "time-keeper",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "time-keeper-db",
      "database_id": "43dc41a3-7bd5-4ade-af41-015f8d2b9718",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "DEMO_MODE": "false",
    "DISCORD_CLIENT_ID": "1559937929860874271"
  }
}
